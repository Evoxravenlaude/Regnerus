# Copy to .env for a local run. On Railway, set these in Variables instead.
# Three of them are secrets: the Telegram token, the database URL and the
# RPC URL (it carries your API key). Never commit a filled-in copy.

# --- required ---
TELEGRAM_BOT_TOKEN=
# Telegram user ids that are admins without an invite code, comma separated.
ADMIN_IDS=
# A Solana RPC endpoint that also serves WebSocket. The Yeks one works.
SOLANA_RPC_URL=

# --- database ---
# Postgres (Supabase: use the direct or session-pooler URL, port 5432).
# Left empty, everything is kept in memory and lost on restart.
DATABASE_URL=
# The bot's own schema. Not "public": Supabase exposes that through its Data API.
DB_SCHEMA=regnerus

# --- optional, with their defaults ---
# Derived from SOLANA_RPC_URL (https -> wss) when empty.
SOLANA_WS_URL=
# processed | confirmed | finalized
SOLANA_COMMITMENT=finalized
RPC_REQUESTS_PER_MIN=600
RPC_BURST=40
# What your RPC plan allows per day, and the part forensics may use.
RPC_DAILY_CREDITS=300000
RPC_FORENSICS_SHARE=0.3
# How often every watched wallet is checked for missed transactions.
BACKFILL_INTERVAL_S=300
BACKFILL_LIMIT=25
# Transactions read silently when a wallet is first tracked.
HISTORY_ON_TRACK=20
# Trades by one entity in one token inside this window are one card.
SIGNAL_WINDOW_S=30
# A trade found later than this is stored without a card.
ALERT_MAX_AGE_S=3600
LOG_LEVEL=INFO
# true: log Telegram messages instead of sending them.
DRY_RUN=false

# ======================= trail and clusters =======================
# The volume filter: SOL sent out below this is not followed.
EXIT_MIN_SOL=0.5
# The deposit test: more distinct senders than this is not one person's address.
DEPOSIT_MAX_SENDERS=8
# How long after a deposit a matching exchange withdrawal still counts.
HOP_WINDOW_HOURS=6
# /trail defaults and limits.
WALK_DAYS=30
WALK_MIN_SOL=5
WALK_HOPS=4
WALK_WALLETS=200
WALK_CREDITS=1500
# Transactions read around each entity buy to find co-buyers. 0 turns it off.
COBUY_TXS=20
# "Thinly bought": fewer transactions than this in the minute around the buy.
COBUY_THIN=25
# A JSON list of labels read at start: [{"address": "...", "class": "cex_hot", "name": "Binance"}]
LABELS_FILE=labels.json

# ============================ trader ============================
# Quotes need no key; a key raises the rate limit. "off" as the URL turns the trader off.
JUPITER_API_URL=https://api.jup.ag/swap/v2
JUPITER_API_KEY=
# Left out of orders so every transaction has one signer and known programs.
JUPITER_EXCLUDE_ROUTERS=jupiterz,dflow,okx
# The bot's own paper copy of every entity buy, in SOL. 0 turns shadow copies off.
SHADOW_SOL=0.1
# A buy seen later than this many seconds is a card, not a copy.
COPY_MAX_AGE_S=120
# How often open positions are priced and their exit rules applied.
MONITOR_INTERVAL_S=20
# A side wallet selling this soon after the entity bought flags the entity as bait.
BAIT_WINDOW_S=600
# SOL left in a trading wallet on buys, for fees and rent.
SOL_RESERVE=0.02

# Real orders are sent only with BOTH of these. Until then every copy is on paper.
EXECUTION_LIVE_MODE=false
# Must be exactly: I_UNDERSTAND_THIS_MOVES_REAL_FUNDS
EXECUTION_LIVE_ACK=

# Where trading keys are held: doppler (recommended) or env.
# The database stores the secret's NAME, never the key.
SECRETS_PROVIDER=env
DOPPLER_TOKEN=
# Needed only for /newwallet, which stores a new key.
DOPPLER_WRITE_TOKEN=
DOPPLER_PROJECT=
DOPPLER_CONFIG=

# ============================ reviewer ============================
# Empty: no reviewer, the bot runs on its heuristics alone.
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-sonnet-5-5
# The most reviews in one day.
REVIEW_DAILY_CAP=20
